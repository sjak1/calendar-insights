# ---------- Bedrock (default LLM) ----------
USE_BEDROCK=1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2
# API key auth (boto3 reads AWS_BEARER_TOKEN_BEDROCK; we set it from bedrock_api_key)
bedrock_api_key=<your-bedrock-api-key>
# Set USE_BEDROCK=0 to use OpenAI instead

# ---------- OpenSearch ----------
OPENSEARCH_URL=https://vpc-biq-el-6btfhssa63uue6ifqd6plwcexy.us-west-2.es.amazonaws.com
OPENSEARCH_USERNAME=biq-eiq
OPENSEARCH_PASSWORD=biqXX0109##
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_TIMEOUT_SECONDS=120
OPENSEARCH_DEFAULT_INDICES=
OPENSEARCH_CONNECTION_TIMEOUT_MS=120000
OPENSEARCH_READ_TIMEOUT_MS=120000
OPENSEARCH_SOCKET_TIMEOUT_MS=120000

# ---------- Spring compatibility values ----------
spring.elasticsearch.rest.uris=https://vpc-biq-el-6btfhssa63uue6ifqd6plwcexy.us-west-2.es.amazonaws.com
spring.elasticsearch.rest.username=biq-eiq
spring.elasticsearch.rest.password=biqXX0109##
spring.elasticsearch.rest.connection-timeout=120000
spring.elasticsearch.rest.read-timeout=120000
spring.data.elasticsearch.client.reactive.use-ssl=false
spring.elasticsearch.rest.socket-timeout=120000
# Dev-only: fallback auth for testing catalog API tools through the local UI
# (used only when the incoming request has no Authorization header)
BRIEFINGIQ_DEV_BEARER=
BRIEFINGIQ_DEV_CUSTOMERID=
BRIEFINGIQ_DEV_CATEGORYID=
BRIEFINGIQ_DEV_USER=

# ---------- Langfuse tracing (optional) ----------
# Leave the keys blank to run without tracing. Keys: Langfuse project
# Settings -> API Keys. Regions: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), https://jp.cloud.langfuse.com (Japan).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keeps dev/staging traces out of production dashboards and evaluations.
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional build identifier, for comparing metrics across releases.
LANGFUSE_RELEASE=
# Email addresses are redacted to [EMAIL]@domain before leaving the app.
# Set to 0 to trace them verbatim. Credentials are always redacted.
LANGFUSE_MASK_PII=1
